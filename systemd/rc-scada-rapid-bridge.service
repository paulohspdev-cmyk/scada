[Unit]
Description=RC Geradores Reverse TCP Bridge for Rapid SCADA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rcscada
Group=rcscada
WorkingDirectory=/opt/rc-scada
EnvironmentFile=/etc/rc-scada.env
ExecStart=/opt/rc-scada/.venv/bin/python -m app.rapid_bridge
Restart=always
RestartSec=3
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
